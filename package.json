{
  "name": "bb-plugin-aura-motion",
  "version": "0.2.0",
  "description": "Video, animated GIF and photo wallpapers with selectable dither textures for BB. Based on Aura by Mateo Cerquetella.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21",
    "node": ">=22.19.0"
  },
  "bb": {
    "name": "Aura Motion",
    "description": "Video, animated GIF and photo wallpapers, seven dither patterns, six saved slots, and an optional activity overview.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/",
    "assets/",
    "lib/",
    "server.ts",
    "app.tsx",
    "app.css",
    "README.md",
    "LICENSE",
    "licenses/",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.29",
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.40.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "author": "Nikos Benakis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickolasBenakis/bb-plugin-aura-motion.git"
  },
  "homepage": "https://github.com/NickolasBenakis/bb-plugin-aura-motion",
  "contributors": [
    "Mateo Cerquetella (original Aura plugin)"
  ]
}
